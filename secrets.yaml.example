# Copy to secrets.yaml; never commit that file or generated firmware/logs.
# Generate a NEW API key: python3 -c 'import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
api_encryption_key: "REPLACE_WITH_A_NEW_32_BYTE_BASE64_KEY"
wifi_ssid: "REPLACE_WITH_WIFI_SSID"
wifi_password: "REPLACE_WITH_WIFI_PASSWORD"
fallback_ap_password: "REPLACE_WITH_UNIQUE_AP_PASSWORD"
ota_password: "REPLACE_WITH_UNIQUE_OTA_PASSWORD"
# Passive capture of commands from YOUR OWN WB3; ASCII alphanumeric, 1..32 chars.
wb3_src: "REPLACE_WITH_YOUR_WB3_SRC"
# Quoted C++ boolean for globals.initial_value, not a YAML boolean.
# Leave false until TX contention, polarity, safety and source checks are done.
uart_tx_enabled: 'false'
